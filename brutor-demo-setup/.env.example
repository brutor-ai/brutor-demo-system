# Brutor Demo System configuration. Copy to .env and set OPENAI_API_KEY.
# Read by demo.sh (exported for docker compose) and by setup.py / verify.py.

# Provider keys. OPENAI_API_KEY is required (gpt-5.2 and gpt-5.5 by default).
# ANTHROPIC_API_KEY is only used if you point a model at an Anthropic entry.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Brutor control plane (admin API) and core proxy (gateway), as seen from the host.
CP_URL=http://localhost:5050
GW_URL=http://localhost:8100

# Tenant admin used for provisioning. Trial defaults; change them in production.
ADMIN_USER=admin
ADMIN_PASSWORD=Admin123!
TENANT_ID=default

# The two models. Both must exist in the tenant (or in the catalog) under these names.
CLASSIFIER_MODEL=gpt-5.2
DRAFTER_MODEL=gpt-5.5

# EU residency enforcement is opt-in: OpenAI and Anthropic are `global` providers in
# the trial, so with block_global the demo would refuse every model call unless the
# models are pointed at an EU endpoint first. Set to 1 to pass --residency to setup.py.
EU_STRICT_RESIDENCY=0

# Runtime knobs passed to the containers by docker-compose.yml.
TICK_SECONDS=600
MAX_PER_TICK=5
GENERATE_INTERVAL_SECONDS=600
# New applications per interval. 2 to 3 (default, about 360 a day) keeps screening runs the bulk of
# the run ledger, so the baselines learn what a screening looks like; about 1.7 percent become
# underwriter holds, about 6 a day, which one person clears in the User Portal each day.
GENERATE_MIN_PER_INTERVAL=2
GENERATE_MAX_PER_INTERVAL=3
LOG_LEVEL=INFO

# Re-raises of a lapsed underwriter hold (0 = unlimited). Keep at 1 until the core
# honours the 24-hour hold window (0.10.95+); every re-raise counts as an escalated run.
RERAISE_MAX=0
