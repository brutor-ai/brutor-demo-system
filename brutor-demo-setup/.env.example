# Brutor Demo System configuration. Copy to .env and set OPENAI_API_KEY.
# Read by demo.sh (exported for docker compose) and by setup.py / verify.py.

# Provider keys. OPENAI_API_KEY is required (gpt-5.2 and gpt-5.5 by default).
# ANTHROPIC_API_KEY is only used if you point a model at an Anthropic entry.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Brutor Agent Control (Community Edition or Enterprise): Control Plane (admin
# API) and Core Gateway, as seen from the host.
CP_URL=http://localhost:5050
GW_URL=http://localhost:8100
TENANT_ID=default

# The tenant administrator: provisions the demo and decides held calls.
# Brutor Agent Control has no stock password; it generates one per installation
# and keeps it in its own .env as BRUTOR_DEFAULT_TENANT_ADMIN_PASSWORD. Point at that
# file (only the administrator's user name and password are read from it):
BRUTOR_ENV_FILE=
# ...or leave BRUTOR_ENV_FILE empty and export BRUTOR_DEFAULT_TENANT_ADMIN_PASSWORD
# (and BRUTOR_DEFAULT_TENANT_ADMIN_USERNAME if it is not `admin`) in your shell.
# If the password was changed in the Admin Console, set these two instead;
# they win over everything above.
ADMIN_USER=
ADMIN_PASSWORD=

# The docker network of the Brutor stack the demo containers join (docker network ls).
BRUTOR_NETWORK=brutor-network

# The credential the agents present (written to .demo.env by setup.py): `workload`, a
# JWT-SVID from the demo's SPIRE (spire/README.md), or `api_key`, the development-stage
# keys in .demo.env. An AI System in production requires workload identity.
BRUTOR_CREDENTIAL=workload
# SPIRE's workload attestor: `docker` (the SPIRE Agent reads the Docker socket) or
# `unix` (the fallback without it: the agents are told apart by their user ids).
SPIRE_WORKLOAD_ATTESTOR=docker

# Host ports, loopback only. Change them (and the URLs, which setup.py and demo.sh
# use) when another stack already uses these.
APPLICATIONS_HOST_PORT=3014
BUREAU_HOST_PORT=3015
FRAUD_HOST_PORT=9200
SCREENING_HOST_PORT=9201
SPIRE_OIDC_HOST_PORT=9208
APPLICATIONS_HOST_URL=http://127.0.0.1:3014
BUREAU_HOST_URL=http://127.0.0.1:3015
FRAUD_HOST_URL=http://127.0.0.1:9200
SCREENING_HOST_URL=http://127.0.0.1:9201

# The two models. Both must exist in the tenant (or in the catalog) under these names.
CLASSIFIER_MODEL=gpt-5.2
DRAFTER_MODEL=gpt-5.5

# EU residency enforcement is opt-in: OpenAI and Anthropic are `global` providers
# as shipped, so with block_global the demo would refuse every model call unless the
# models are pointed at an EU endpoint first. Set to 1 to pass --residency to setup.py.
EU_STRICT_RESIDENCY=0

# Runtime knobs passed to the containers by docker-compose.yml.
TICK_SECONDS=600
MAX_PER_TICK=5
GENERATE_INTERVAL_SECONDS=600
# New applications per interval. 2 to 3 (default, about 360 a day) keeps screening runs the bulk of
# the run ledger, so the baselines learn what a screening looks like; about 1.7 percent become
# underwriter holds, about 6 a day, which one person clears each day (Admin Console,
# Mission Control -> Approvals).
GENERATE_MIN_PER_INTERVAL=2
GENERATE_MAX_PER_INTERVAL=3
LOG_LEVEL=INFO

# Re-raises of a lapsed underwriter hold (0 = unlimited). Every re-raise counts as an
# escalated run.
RERAISE_MAX=0

# Build id of the two agents' release, baked into their images at build time and
# sent as X-Brutor-Agent-Build, e.g. `BRUTOR_AGENT_BUILD=$(git rev-parse --short HEAD) ./demo.sh up`
# (an exported value wins over this file). Empty = no build header; name and version always come
# from each agent's pyproject.toml.
BRUTOR_AGENT_BUILD=
